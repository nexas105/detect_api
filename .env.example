# API
# Storage backend: "local" (filesystem) or "s3" (S3-compatible, e.g. MinIO)
STORAGE_BACKEND=local
STORAGE_DIR=/app/storage
MODEL_DIR=/app/models

# S3 / MinIO (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=detect-api
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# When true, /images and /storage GETs return a 307 to a presigned URL
# instead of proxying the bytes through the API. Recommended for S3.
S3_USE_PRESIGNED_URLS=true
S3_PRESIGN_EXPIRES=3600
API_PORT=8000
API_HOST=0.0.0.0
AUTH_SERVICE_URL=http://auth:8001

# Auth
AUTH_PORT=8001
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Shared secret between API and Auth services for internal endpoints.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=change-me-to-a-random-hex-string

# Database
DATABASE_URL=postgresql+asyncpg://erohub:erohub@db:5432/erohub
DB_USER=erohub
DB_PASSWORD=erohub
DB_NAME=erohub
DB_PORT=5432
DB_DATA_DIR=./db/data

# Redis (optional — omit or leave empty for DB fallback)
REDIS_URL=

# ML Workers (0=inline ~2GB, 1=2GB, 2=2.8GB, 4=3.5GB)
ML_WORKERS=0

# API Limits
MAX_UPLOAD_SIZE=52428800
MAX_VIDEO_SIZE=209715200
MAX_VIDEO_DURATION=300

# Studio
STUDIO_PORT=3000

# Studio env
NEXT_PUBLIC_AUTH_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS — use CORS_ORIGINS for explicit list, CORS_ORIGIN_REGEX for LAN/mDNS patterns
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|.+\.local|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+):3000$

# Coolify / Production Domains (only needed with docker-compose.coolify.yml)
# DOMAIN_API=api.example.com
# DOMAIN_AUTH=auth.example.com
# DOMAIN_STUDIO=studio.example.com
